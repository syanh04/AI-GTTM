# Backend Environment Configuration Template
# AI-GTTM: Intelligent Traffic Surveillance & ALPR Engine

# Application Environment (development / production)
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to local SQLite if unset; PostgreSQL supported)
DATABASE_URL=sqlite:///./alpr.db
# DATABASE_URL=postgresql://user:password@localhost:5432/traffic_ai

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Runtime Data Storage Paths
MODELS_DIR=./models
RUNTIME_DATA_DIR=.
VIOLATION_CONFIG_PATH=./violation_configs.json

# Notification Services (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ZALO_APP_ID=your_zalo_app_id_here
ZALO_APP_SECRET=your_zalo_app_secret_here
